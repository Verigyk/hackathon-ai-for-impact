# Copy to .env.local. All keys stay on the server.
BACKEND_URL=http://127.0.0.1:8000
DEMO_MODE=true
# Optional live integrations (backend reads environment or .env.local)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
TAVILY_API_KEY=
MIN_CONFIDENCE=70
OPTION_TTL_MINUTES=30

# Local Ollama (no API key required)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=mistral:latest

# Public web discovery and IGN walking routes (no API key required)
WEB_DISCOVERY=true
